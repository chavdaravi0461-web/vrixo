# ============================================================
# VRIXO PRODUCTION ENVIRONMENT VARIABLES
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://www.vrixo.in

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Redis (for BullMQ queues) ---
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=vrixo
QUEUE_ADD_TIMEOUT_MS=1200
REDIS_CONNECT_TIMEOUT_MS=5000
WHATSAPP_WORKER_CONCURRENCY=6
WHATSAPP_LOG_TTL_SECONDS=2592000
WHATSAPP_MAX_LOGS_PER_ORDER=100
WHATSAPP_MAX_TIMELINE_LOGS=2000

# --- WhatsApp Cloud API ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_ORDER_TEMPLATE_NAME=order_confirmation_vrixo
WHATSAPP_TEMPLATE_LANGUAGE=en
# Keep this on a Meta-supported Graph API version and update it deliberately.
WHATSAPP_GRAPH_API_VERSION=v23.0
# WHATSAPP_VERIFY_TOKEN and WHATSAPP_WEBHOOK_SECRET MUST be different values.
# WHATSAPP_VERIFY_TOKEN is the token Meta sends back during webhook setup (GET verification).
# WHATSAPP_WEBHOOK_SECRET is your Meta App Secret from Developer Portal → Settings → Basic.
WHATSAPP_VERIFY_TOKEN=replace-with-unique-verify-token-max-512-chars
WHATSAPP_WEBHOOK_SECRET=replace-with-meta-app-secret-different-from-verify-token
# Optional fallback if WHATSAPP_WEBHOOK_SECRET is not set — set to the same Meta App Secret.
META_APP_SECRET=replace-with-meta-app-secret-same-as-webhook-secret

# --- Authentication ---
ADMIN_ACCESS_CODE=replace-with-optional-extra-admin-code
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
CHECKOUT_TOKEN_SECRET=replace-with-at-least-32-random-characters
OTP_AUTH_SECRET=replace-with-at-least-32-random-characters-if-otp-is-enabled

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
SMS_PROVIDER=twilio

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=

# --- Notifications ---
NOTIFICATION_WORKER_SECRET=replace-with-a-secure-worker-secret
NOTIFICATION_POLL_INTERVAL_MS=2000
NOTIFICATION_BATCH_SIZE=25
NEXT_PUBLIC_SUPPORT_EMAIL=support@vrixo.in

# --- Internal / System API Secrets ---
ADMIN_API_KEY=replace-with-a-long-random-server-to-server-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
HEALTH_CHECK_KEY=replace-with-a-long-random-health-secret
INTERNAL_HEALTH_KEY=replace-with-a-long-random-internal-health-secret
HEALING_ENGINE_KEY=replace-with-a-long-random-healing-secret
FAILURE_SIMULATION_KEY=replace-with-a-long-random-simulation-secret
WHATSAPP_ADMIN_SECRET=replace-with-a-long-random-whatsapp-admin-secret

# --- Email ---
EMAIL_API_KEY=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Worker ---
# Set START_WORKER=true in non-Vercel environments (e.g., Railway, Render, or your own server)
START_WORKER=false
